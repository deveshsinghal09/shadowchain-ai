{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "VerifyPrivateExportBucket", "Effect": "Allow", "Action": ["s3:GetBucketPublicAccessBlock", "s3:GetBucketPolicyStatus", "s3:GetBucketAcl"], "Resource": "arn:aws:s3:::<BUCKET>", "Condition": {"Bool": {"aws:SecureTransport": "true"}}},
    {"Sid": "VerifyExistingReportMetadata", "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::<BUCKET>/shadowchain-reports/*", "Condition": {"Bool": {"aws:SecureTransport": "true"}}},
    {"Sid": "UploadEncryptedRedactedReports", "Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::<BUCKET>/shadowchain-reports/*", "Condition": {"Bool": {"aws:SecureTransport": "true"}, "StringEquals": {"s3:x-amz-server-side-encryption": "AES256"}}}
  ]
}
