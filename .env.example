# Copy using scripts/setup.ps1; it replaces the placeholder with a random local password.
# Never commit .env. These values contain no AWS credentials or LLM API keys.
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
BACKEND_PORT=8000

# JSON arrays are required for CORS lists. No wildcard credentialed origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false

# Fail closed: only health/ready are public. Run scripts/setup-api-auth.ps1 for a local key.
# Store only SHA-256 token digests, tenant bindings and explicit permissions here, never raw tokens.
API_CLIENTS=[]
API_QUERY_LIMIT_PER_MINUTE=30
API_REQUEST_MAX_BYTES=131072
WS_POLL_SECONDS=1
WS_SEND_TIMEOUT_SECONDS=5

# Compose resolves this private hostname; do not publish port 6379 or 3000.
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=replace-with-random-local-password
FALKORDB_GRAPH=shadowchain
FALKORDB_TLS=false
FALKORDB_CONNECT_TIMEOUT_SECONDS=2
FALKORDB_SOCKET_TIMEOUT_SECONDS=3
FALKORDB_QUERY_TIMEOUT_MS=2000
FALKORDB_MAX_CONNECTIONS=20
FALKORDB_RETRY_ATTEMPTS=3
FALKORDB_RETRY_BACKOFF_SECONDS=0.05
FALKORDB_SCHEMA_TIMEOUT_SECONDS=30

# Optional AWS integration: no clients or provider-chain lookups until explicitly triggered.
AWS_ENABLED=false
CLOUDTRAIL_ENABLED=false
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCOUNT_ID=
AWS_TENANT_ID=shadowchain-aws-import
AWS_MAX_RECORDS=300
AWS_MAX_PAGES=20
EXPORT_MODE=local
S3_EXPORT_BUCKET=
EXPORT_LOCAL_DIR=artifacts/reports
GEMINI_API_KEY=

# Agents use deterministic mock summaries by default. Gemini receives only allowlisted counts/IDs.
AGENT_PROVIDER=mock
GEMINI_MODEL=gemini-3.8-flash
AGENT_MODEL_TIMEOUT_SECONDS=5
AGENT_MODEL_ATTEMPTS=2
WORKFLOW_LEASE_SECONDS=120
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_RECOVERY_ENABLED=true
WORKFLOW_RECOVERY_INTERVAL_SECONDS=2
WORKFLOW_RECOVERY_LIMIT=10
