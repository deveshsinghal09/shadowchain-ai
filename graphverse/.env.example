# Server-only configuration. Never put credentials into VITE_* variables.
PORT=3100
HOST=127.0.0.1
GRAPHVERSE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3100
GRAPHVERSE_GRAPH=graphverse_demo_v1
GRAPHVERSE_TENANT=graphverse-synthetic
# Absolute path to a private operator token file; minimum 32 characters.
GRAPHVERSE_TOKEN_FILE=
# Hosted deployments may use a secret variable instead of a local file.
GRAPHVERSE_OPERATOR_TOKEN=
GRAPHVERSE_DATASET=graphverse-synthetic-1.0
GRAPHVERSE_AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=16379
FALKORDB_USERNAME=default
# In local development the repository .env supplies this value if omitted.
FALKORDB_PASSWORD=
# Only set true behind HTTPS. Public deployment also needs end-user authentication.
GRAPHVERSE_SECURE_COOKIE=false
